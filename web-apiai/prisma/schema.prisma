generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Congregacao {
  SEDE
  PINHEIROS
  LAGEADO
  FLOR_DO_TEMPLO
  RIBEIRA
  LARANJAL
  CARACINHAS
}

enum Cargo {
  PASTOR
  DIACONO
  EVANGELISTA
  PRESBITERO
  OFICIAL_SOCIEDADES
  MEMBRO_COMUNGANTE
}

model Usuarios {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  dataNascimento  DateTime @unique
  igreja Congregacao @default(SEDE) @unique
  telefone String?
  cargo String @unique
  dataProfissaoFe  DateTime @unique
  dataBatismo DateTime @unique

  createdAt DateTime @default(now())
}
