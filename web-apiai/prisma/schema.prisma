generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Congregacao {
  SEDE
  PINHEIROS
  LAGEADO
  FLOR_DO_TEMPLO
  RIBEIRA
  LARANJAL
  CARACINHAS
}

enum Cargo {
  PASTOR
  DIACONO
  EVANGELISTA
  PRESBITERO
  OFICIAL_SOCIEDADES
  MEMBRO_COMUNGANTE
}

model Usuarios {
  id        Int      @id @default(autoincrement()) 
  name      String
  email     String   @unique
  dataNascimento  DateTime 
  igreja Congregacao @default(SEDE) 
  telefone String?
  cargo String 
  dataProfissaoFe  DateTime 
  dataBatismo DateTime 

  createdAt DateTime @default(now())
}

model Sermoes {
  id          Int      @id @default(autoincrement())
  titulo       String @unique
  descricao String 
  audioUrl    String
  createdAt DateTime @default(now())
}
